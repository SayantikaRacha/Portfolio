# ============================================================
# SIA PORTFOLIO — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your Supabase values.
# NEVER commit your real .env file to GitHub.
# ============================================================

# Your Supabase Project URL — found in Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon/Public Key — found in Project Settings > API
# This key is safe to use in frontend code WITH proper RLS policies.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER add your service_role key here. It is for server-side use only.
